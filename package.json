{
  "name": "aether-quill",
  "version": "1.0.0",
  "description": "RAG 小说写作系统 - Aether Quill",
  "private": true,
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev": "pnpm run dev:stack",
    "dev:stack": "pnpm --parallel --filter @aether-quill/web --filter @aether-quill/api --filter @aether-quill/rag-orchestrator --filter @aether-quill/worker dev",
    "dev:packages": "pnpm -r --filter \"./packages/**\" dev",
    "dev:all-recursive": "pnpm -r dev",
    "clean": "pnpm -r clean"
  },
  "keywords": [
    "rag",
    "novel",
    "writing",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.32.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "axios": "^1.6.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vue-eslint-parser": "^9.4.0"
  },
  "dependencies": {
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.7",
    "ioredis": "^5.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1"
  }
}
