# Aether Quill 环境变量示例
# 复制此文件为 .env 并填入真实值

# ========================================
# Docker Compose 配置（本地开发依赖）
# ========================================
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether123
POSTGRES_DB=aether_quill
POSTGRES_PORT=5432

REDIS_PORT=6379

QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ========================================
# 应用服务配置
# ========================================
# 数据库
POSTGRES_HOST=localhost

# API → Worker 索引进度（默认 http://localhost:3002；索引前请确保 Worker 已启动）
# WORKER_URL=http://localhost:3002

# Redis
REDIS_HOST=localhost

# 向量数据库
QDRANT_HOST=localhost

# 对象存储
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=aether
MINIO_SECRET_KEY=aether123
MINIO_BUCKET=aether-quill

# ========================================
# RAG：向量 / Embedding（rag-orchestrator + worker 启动硬校验）
# 本地无密钥 CI 可设 AETHER_QUILL_SKIP_RAG_INFRA_ENV_VALIDATION=true（禁止用于 production）
# ========================================
VECTOR_PROVIDER=qdrant
# 二选一：完整 URL，或 QDRANT_HOST + QDRANT_PORT
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# SILICONFLOW_API_KEY= 或复用 LLM_API_KEY
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1

RETRIEVAL_TOPK=30
RERANK_TOPN=10
RETRIEVAL_MIN_SCORE=0.2

INGEST_CHUNK_TOKEN_SIZE=700
INGEST_CHUNK_TOKEN_OVERLAP=100
INGEST_SEGMENTER=paragraph-first

# AETHER_QUILL_SKIP_RAG_INFRA_ENV_VALIDATION=true

# ========================================
# AI / 章节生成（rag-orchestrator，与上方 Embedding 可共用 SiliconFlow 密钥）
# 解析顺序见 services/rag-orchestrator/src/generation/generation.service.ts
# ========================================
# 模型调用密钥（至少配置其一；仅设 SILICONFLOW_API_KEY 且不设 DEEPSEEK/PROVIDER_API_KEY 时走 SiliconFlow）
# PROVIDER_API_KEY=
# PROVIDER_API_URL=
DEEPSEEK_API_KEY=sk-xxx
# SILICONFLOW_API_KEY=
# 与 Embedding 共用 SiliconFlow 时，可只设 SILICONFLOW_API_KEY，并设好上方 EMBEDDING_*；LLM 侧也可用：
# LLM_API_KEY=

PROVIDER_MODEL=deepseek-chat
PROVIDER_MAX_TOKENS=4096
# PROVIDER_TEMPERATURE=0.7

# 以下多为历史/占位，当前 rag 生成链路不强制读取；保留便于本地统一维护
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=xxx
