# Aether Quill 环境变量示例
# 复制此文件为 .env 并填入真实值

# 数据库
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether123
