# Aether Quill 环境变量示例
# 复制此文件为 .env 并填入真实值

# ========================================
# Docker Compose 配置（本地开发依赖）
# ========================================
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether123
POSTGRES_DB=aether_quill
POSTGRES_PORT=5432

REDIS_PORT=6379

QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ========================================
# 应用服务配置
# ========================================
# 数据库
POSTGRES_HOST=localhost
# API 使用 Prisma 时必填（与 docker-compose 中 POSTGRES_* 一致；未设置则继续走 JSON 落盘 `services/api/data/*.json`）
# DATABASE_URL=postgresql://aether:aether123@127.0.0.1:5432/aether_quill

# API → Worker 索引进度（默认 http://localhost:3002；索引前请确保 Worker 已启动）
# WORKER_URL=http://localhost:3002

# Redis
REDIS_HOST=localhost

# 向量数据库
QDRANT_HOST=localhost

# 对象存储
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=aether
MINIO_SECRET_KEY=aether123
MINIO_BUCKET=aether-quill

# ========================================
# RAG：向量 / Embedding（rag-orchestrator + worker 启动硬校验）
# 本地无密钥 CI 可设 AETHER_QUILL_SKIP_RAG_INFRA_ENV_VALIDATION=true（禁止用于 production）
# ========================================
VECTOR_PROVIDER=qdrant
# 二选一：完整 URL，或 QDRANT_HOST + QDRANT_PORT
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# SILICONFLOW_API_KEY= 或复用 LLM_API_KEY
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
# 批量同步章节摘要到 Qdrant 时限速（毫秒，默认 350）；失败时重试次数/退避基数
# CHAPTER_SUMMARY_INDEX_DELAY_MS=350
# CHAPTER_SUMMARY_INDEX_MAX_RETRIES=3
# CHAPTER_SUMMARY_INDEX_RETRY_BASE_MS=600

RETRIEVAL_TOPK=30
RERANK_TOPN=10
RETRIEVAL_MIN_SCORE=0.2
# 重排：向量分与词法分融合权重（默认 0.7 / 0.3）；RERANK_PROVIDER 留空走融合
RERANK_VECTOR_WEIGHT=0.7
RERANK_LEXICAL_WEIGHT=0.3
RERANK_MAX_PER_DOC=1
# RERANK_PROVIDER=cross-encoder

INGEST_CHUNK_TOKEN_SIZE=700
INGEST_CHUNK_TOKEN_OVERLAP=100
INGEST_SEGMENTER=paragraph-first

# AETHER_QUILL_SKIP_RAG_INFRA_ENV_VALIDATION=true

# ========================================
# AI / 章节生成（rag-orchestrator）
# ========================================
# 【模型 / 温度 / 厂商】请在前端顶栏「设置」→ 全局模型设置中配置。
# 默认：DeepSeek + deepseek-v4-flash + 温度 0.7（写作/常规相同）。
# 本文件只放密钥与必要运行参数；双厂商时两把 key 都要配。
#
DEEPSEEK_API_KEY=sk-xxx
# SILICONFLOW_API_KEY=   # 可与上方 Embedding 共用；选硅基流动模型时必填
# PROVIDER_API_KEY=      # 可选通用兜底；双厂商时不推荐
#
# 厂商 URL（可选；默认官方地址）
# DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/chat/completions
# SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1

PROVIDER_MAX_TOKENS=4096
# 可选：仅写作档 frequency_penalty；未配置则不传
# PROVIDER_FREQUENCY_PENALTY_WRITING=0.3

# AQ-249：为 1 时 LLM 主生成回退单条 user（含【系统指令】）；默认 0 使用 system+user 双消息
# LLM_PROMPT_LEGACY_SINGLE_USER=0

# 生成链路 prompt 调试日志（写作工作台 + 章节优化；默认开启）
# LOG_GENERATION_PROMPT=true
# LOG_WRITE_CHAPTER_PROMPT=true
# LOG_PIPELINE_PROMPT=true

# 结构化解析：角色卡标题正文匹配补全（默认开启；设为 0 或 false 关闭）
# PERSONA_KEYWORD_SUPPLEMENT=0

# 章节优化：将优化要求/关注角色并入标题匹配（默认开启；设为 0 或 false 关闭）
# CHAPTER_OPTIMIZE_PERSONA_MATCH=0

# AQ-257：章节优化长文本分段（默认开启；设为 0 关闭）
# CHAPTER_OPTIMIZE_SEGMENTATION_ENABLED=1
# CHAPTER_OPTIMIZE_SINGLE_SEGMENT_CHAR_THRESHOLD=2800
# CHAPTER_OPTIMIZE_SEGMENT_CHAR_SIZE=3000

# 以下多为历史/占位，当前 rag 生成链路不强制读取；保留便于本地统一维护
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=xxx
