{
  "name": "@aether-quill/worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "pnpm --filter @aether-quill/config run build && pnpm --filter @aether-quill/model-providers run build && tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@aether-quill/config": "workspace:*",
    "@aether-quill/model-providers": "workspace:^",
    "@qdrant/js-client-rest": "^1.14.0",
    "axios": "^1.7.0",
    "bullmq": "^5.76.0",
    "express": "^5.2.1",
    "gpt-tokenizer": "^2.8.0",
    "ioredis": "^5.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
