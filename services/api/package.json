{
  "name": "@aether-quill/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @aether-quill/config run build && nest start --watch",
    "build": "nest build && prisma generate",
    "start": "nest start",
    "start:prod": "node dist/main",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "pnpm --filter @aether-quill/config run build && tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "clean": "rm -rf dist node_modules",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "migrate:json-to-pg": "prisma generate && tsx scripts/migrate-json-to-pg.ts"
  },
  "dependencies": {
    "@aether-quill/config": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "5.22.0",
    "axios": "^1.7.0",
    "bcrypt": "^6.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "dotenv": "^16.4.5",
    "prisma": "5.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
