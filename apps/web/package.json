    "eslint-plugin-vue": "^9.33.0",
    "tsx": "^4.19.4",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.0.0"
